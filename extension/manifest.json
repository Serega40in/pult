{
  "manifest_version": 3,
  "name": "PULT Lite — ChatGPT Browser Control",
  "version": "0.2.0",
  "description": "Простой мост между ChatGPT и вкладками Chrome. Выполняет только явные команды PULT после нажатия пользователем.",
  "permissions": ["storage", "tabs", "scripting", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "PULT Lite",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt.js"],
      "run_at": "document_idle"
    }
  ]
}